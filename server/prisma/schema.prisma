// SoberLife — core data model
//
// Scope: apartments, beds, residents, stays, bed history, staff, audit.
// Event tables (apartment checks, screens, med pass, service hours, sign-outs,
// passes) come in later slices and follow the amendment pattern noted at the
// bottom of this file. The schedule design is also noted there — decided, not
// yet built.

// Prisma 7: the connection URL is NOT declared here. It lives in
// server/prisma.config.js for migrations, and reaches the client via the
// driver adapter (@prisma/adapter-pg) in src/db/client.js.
datasource db {
  provider = "postgresql"
}

// `prisma-client-js` (the pre-v7 generator), NOT the v7 default `prisma-client`.
// The v7 generator emits TypeScript, which this project does not use — see
// CLAUDE.md. This one emits real .js plus .d.ts, so we get editor autocomplete
// on every model without adopting a build step.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — mirrored as constants in server/src/domain/
// ─────────────────────────────────────────────────────────────────────────────

/// The housing + scheduling track. NOT a gender-identity field — see the note
/// on Resident.cohort. An apartment serves exactly one cohort.
enum Cohort {
  MEN
  WOMEN
}

/// How a scheduled occurrence repeats. Deliberately two values and no RRULE:
/// every-other-week and monthly-by-nth-weekday are not things this facility
/// runs, and a parser for them is a dependency plus a class of bug for nothing.
/// Mon/Wed/Fri is ONE weekly occurrence with three weekdays, not three rows.
enum Recurrence {
  ONCE
  WEEKLY
}

/// What happened for one person at one dated session. Absent and excused are
/// distinct outcomes, the same way a refused screen is not a positive one —
/// "he did not come" and "he was allowed not to come" are different facts and
/// collapsing them destroys the one that defends the facility.
enum AttendanceStatus {
  ATTENDED
  ABSENT
  EXCUSED
}

enum StaffRole {
  ADMIN
  HOUSE_MANAGER
  STAFF
  RESIDENT
}

/// Physical state of the bed only. Occupancy is NOT stored here — it is derived
/// from BedAssignment so the two can never disagree.
enum BedStatus {
  ACTIVE
  OUT_OF_SERVICE
}

enum StayStatus {
  ACTIVE
  DISCHARGED
}

/// The sign of a ledger line lives here, not in the amount. A negative CHARGE
/// and a PAYMENT would be two ways to write the same thing, and the balance
/// would then depend on which one whoever typed it happened to pick.
enum LedgerEntryType {
  CHARGE // rent, fees, damages — increases what is owed
  PAYMENT // money received — decreases it
  CREDIT // a waiver, a write-off, or an overcharge corrected — also decreases it
}

/// What a charge is FOR. The ledger is not a rent ledger — a resident's balance
/// carries laundry, trips, program fees and damages too, and "how much did we
/// bill in laundry last quarter" is not answerable by grepping descriptions.
enum LedgerCategory {
  RENT
  LAUNDRY
  TRIP
  PROGRAM_FEE
  DAMAGE
  /// The $50 a resident pays to send a non-negative screen for lab
  /// confirmation (module 5). Its own category rather than PROGRAM_FEE because
  /// categories exist so "what did we bill in X last quarter" is answerable,
  /// and this is a figure a facility gets asked about.
  ///
  /// Disclosure worth knowing: confirmation is only ever offered on a
  /// non-negative, so a LAB_FEE line on a balance — which any staff member may
  /// read — implies a non-negative screen. Descriptions carry no result and no
  /// substance for that reason.
  LAB_FEE
  OTHER
}

enum DischargeType {
  SUCCESSFUL
  AMA // left against medical advice / self-discharge
  ADMINISTRATIVE // discharged by the facility
  TRANSFER
}

enum AuditAction {
  READ
  CREATE
  UPDATE
  AMEND
  SOFT_DELETE
  LOGIN
  LOGIN_FAILED
  EXPORT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  NORMAL
  URGENT
}

/// The two transitions worth a permanent row. See MaintenanceEvent.
enum MaintenanceEventKind {
  CLOSED
  REOPENED
}

/// The outcome of a screen — the cup's, and later the lab's.
///
/// REFUSAL and DILUTE are their own outcomes and are NEVER collapsed into a
/// failure: "he would not give a sample" and "the sample was watered down" are
/// different facts about a person, with different consequences, and a system
/// that reports both as "positive" is one an auditor cannot trust. This is why
/// the theme carries --warning beside --destructive.
enum ScreenResult {
  NEGATIVE
  POSITIVE
  REFUSAL
  DILUTE
  /// Collected but not yet read. A LAB result is never PENDING — it is simply
  /// absent until it returns, and `confirmation` carries that state.
  PENDING
}

/// Why this screen happened. Selection is recorded, never generated: the app
/// has no randomizer and no cron, so however the house draws names, it draws
/// them and this records the result.
enum ScreenReason {
  RANDOM
  FOR_CAUSE
}

/// What kind of test it was. Module 5 says "records test type" and the
/// glossary says "a urinalysis OR OTHER TEST" — a breathalyzer recorded as a
/// UA is a lie in the record. Three values because that is what a sober living
/// house actually uses; adding one is a single ALTER TYPE.
enum ScreenMethod {
  URINE
  ORAL_FLUID
  BREATH
}

/// The panel. A Postgres enum ARRAY column rather than free text, so the
/// database rejects an off-list value exactly as it rejects an off-list
/// result — CLAUDE.md's "with no compiler, the schema is the type system".
/// Free strings are how "THC", "Thc" and "Marijuana" come to coexist in one
/// column and no report can ever be trusted again.
enum Substance {
  ALCOHOL
  AMPHETAMINES
  BARBITURATES
  BENZODIAZEPINES
  BUPRENORPHINE
  COCAINE
  FENTANYL
  MDMA
  METHADONE
  METHAMPHETAMINE
  OPIATES
  OXYCODONE
  PCP
  THC
  OTHER
}

/// Where a screen sits in the lab-confirmation arc.
///
/// The facility's rule (2026-08-06): a non-negative cup is not the last word.
/// The RESIDENT decides whether the sample goes to a lab, and pays for it if
/// they do. Their decision either way is evidence — "he was offered
/// confirmation and declined" is precisely the kind of claim this app exists
/// to be able to prove.
enum ConfirmationStatus {
  /// Nothing to confirm: the cup was negative, or there is no sample because
  /// the resident refused.
  NOT_OFFERED
  /// Non-negative, waiting on the resident's answer.
  PENDING_DECISION
  /// They were offered it and said no. A terminal state, and a record.
  DECLINED
  /// They said yes, the fee is posted, the sample is with the lab.
  REQUESTED
  /// The lab has reported.
  RETURNED
}

/// An invoice's state, MIRRORING STRIPE's own. It deliberately has no OVERDUE
/// member: overdue is `dueAt < now` and a clock, which is derived on read like
/// PRESENCE and CHECK_STATE. A stored OVERDUE would need something to flip it
/// and would lie the minute that something lagged.
enum InvoiceStatus {
  /// Ours, not Stripe's: swept and totalled locally, not yet sent. A crash
  /// between the local write and Stripe leaves an invoice here, which is a
  /// recoverable state rather than a lost charge.
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum CheckResidentStatus {
  /// Seen on site. What they were doing is REQUIRED (CHECK in the migration).
  PRESENT
  /// Accounted for by an open sign-out — recorded so the check is complete
  /// evidence of the whole apartment, not just of whoever was home.
  SIGNED_OUT
  /// Expected on site and not found. Lights the bell until a later check,
  /// a sign-out, or a discharge accounts for them.
  NOT_FOUND
}

/// What happened at one dose of one medication.
///
/// THREE members, and the absence of MISSED is the design rather than an
/// oversight. A missed dose is the ABSENCE of a record — derived on read from a
/// scheduled instant older than MED_PASS_GRACE_MS with no log against it, the
/// same way PRESENCE, CHECK_STATE and SESSION_STATE are derived. Storing it
/// would make "nobody ran the pass" indistinguishable from "we ran it and
/// marked everyone missed": the first is the evidence gap the alarm exists to
/// find, and a storable MISSED lets it be silenced with a tap.
///
/// HELD is what staff reach for instead, and it carries a required note — the
/// honest record of a dose deliberately not given.
enum MedLogStatus {
  /// Handed over and observed being taken. The ordinary case, no note needed.
  GIVEN
  /// The resident declined it. Note REQUIRED (CHECK in the migration): an
  /// unexplained refusal is a half-filled form that reached the table.
  REFUSED
  /// Staff deliberately did not give it — asleep, off property, held pending a
  /// prescriber call. Note REQUIRED, for the same reason.
  HELD
}

enum DocumentType {
  RESIDENT_AGREEMENT
  PHOTO_ID
  INSURANCE
  REFERRAL
  INTAKE_FORM
  DISCHARGE_SUMMARY
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// Property: Apartment → Bed
// ─────────────────────────────────────────────────────────────────────────────

/// The physical unit. Beds hang directly off it — there is no room level, and
/// inspections are apartment checks rather than room checks.
///
/// An apartment serves exactly ONE cohort. This is the mechanism that keeps men
/// and women housed separately: it is a property of the unit, not a filter
/// applied at query time.
model Apartment {
  id     String @id @default(uuid(7))
  name   String @unique
  cohort Cohort

  /// No timezone or address here on purpose: the facility is a single site at a
  /// single address, so both are facility-wide rather than per-unit. The
  /// timezone lives in FACILITY_TIMEZONE. If a second site in another zone ever
  /// opens, that is the assumption to revisit.
  beds                Bed[]
  maintenanceRequests MaintenanceRequest[]
  checks              ApartmentCheck[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Referenced by Bed's composite foreign key — the first link in the chain
  /// that makes a cohort mismatch impossible at the database level.
  ///
  /// Consequence worth knowing: Postgres will refuse to flip an apartment's
  /// cohort while it still has beds. Converting a men's apartment to women's
  /// is therefore an explicit, deliberate operation, not an UPDATE someone can
  /// fire while people are living in it.
  @@unique([id, cohort])
  @@map("apartments")
}

model Bed {
  id          String @id @default(uuid(7))
  apartmentId String

  /// Carried down from the apartment so the composite FK below can exist. A bed
  /// cannot claim a cohort its apartment does not have.
  cohort    Cohort
  apartment Apartment @relation(fields: [apartmentId, cohort], references: [id, cohort])

  /// Bed label within the apartment — "A", "B", "1". Combined with the
  /// apartment name this is what staff say out loud: "12B".
  label String

  status           BedStatus @default(ACTIVE)
  outOfServiceNote String?

  assignments BedAssignment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([apartmentId, label])
  /// Referenced by BedAssignment's composite foreign key.
  @@unique([id, cohort])
  @@map("beds")
}

// ─────────────────────────────────────────────────────────────────────────────
// Maintenance
// ─────────────────────────────────────────────────────────────────────────────

/// Work needed on an apartment: a broken latch, a dead water heater, a leak.
///
/// Raised against an APARTMENT, never a bed. Maintenance is a property of the
/// unit. Whether a specific bed is usable is a separate fact recorded on the bed
/// itself (`Bed.status` + `outOfServiceNote`), and neither drives the other —
/// filing a request does not take a bed out of service, and resolving one does
/// not put it back.
model MaintenanceRequest {
  id          String    @id @default(uuid(7))
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id])

  title       String
  description String?
  status      MaintenanceStatus   @default(OPEN)
  /// Drives the alarm: a request is overdue against MAINTENANCE_TARGET_MS for
  /// its OWN priority, derived on read. That is why raising priority is
  /// all-staff and lowering it is managers — anyone may shout, only a manager
  /// may quiet it.
  priority    MaintenancePriority @default(NORMAL)

  reportedById String
  reportedBy   User     @relation("reportedRequests", fields: [reportedById], references: [id])
  reportedAt   DateTime @default(now())

  /// IN_PROGRESS means somebody owns this, and a CHECK says so: the status may
  /// not be IN_PROGRESS with neither an assignee nor a vendor. The two are
  /// deliberately NOT mutually exclusive — a house manager who owns the job and
  /// called a plumber is one request, not two.
  assignedToId String?
  assignedTo   User?   @relation("assignedRequests", fields: [assignedToId], references: [id])

  /// The outside contractor, and their reference for the job. Free text, the
  /// same call ServiceEntry.supervisorName made: a relation would mean a
  /// directory of external companies and a picker on a hallway form. These
  /// exist because the facility was already writing "work order 118" into the
  /// description, which is a field doing a job it was not built for.
  vendorName   String?
  workOrderRef String?

  /// Closing and reopening are APPENDED here, never overwritten. The columns
  /// this replaces (resolvedById, resolvedAt, resolutionNote) were dropped
  /// 2026-08-07: reopening cleared them, so a request closed, reopened and
  /// closed again could only ever describe the second closure. Keeping them
  /// alongside the trail would be a second copy that can disagree — the same
  /// reasoning that dropped ServiceEntry.supersededById.
  events MaintenanceEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([apartmentId, status])
  @@index([status, priority])
  @@map("maintenance_requests")
}

/// One closing or reopening of a request. Append-only by trigger AND by revoked
/// privilege, asserted separately in verify-maintenance.js — the app role fails
/// on privilege before a trigger is reached; a superuser, which bypasses RLS
/// even with FORCE, fails on the trigger.
///
/// Deliberately only these two kinds. Starting work and changing priority are
/// ordinary updates and leave no row here: the facility asked for a trail of the
/// consequential transitions, not an event log of everything.
///
/// Outside SOFT_DELETE_MODELS on purpose, like ScheduleSession and the check
/// tables — soft-deleting a trail row would hide the fact it records.
model MaintenanceEvent {
  id        String             @id @default(uuid(7))
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id])

  kind MaintenanceEventKind

  /// Which closed state, for a CLOSED row; null on a REOPENED one. Paired by
  /// CHECK. Reuses MaintenanceStatus rather than growing a second vocabulary
  /// for the same two words.
  closedAs MaintenanceStatus?

  /// Required on BOTH kinds, and non-empty by CHECK. On a closure it is what
  /// was done; on a reopening it is why the work did not hold. This is the rule
  /// that used to live only in a service function and could be bypassed by any
  /// other code path.
  note String

  actorId String
  actor   User     @relation("maintenanceEvents", fields: [actorId], references: [id])
  at      DateTime @default(now())

  @@index([requestId, at])
  @@map("maintenance_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// People
// ─────────────────────────────────────────────────────────────────────────────

/// A person. Survives discharge and readmission — the episode lives on Stay.
model Resident {
  id        String @id @default(uuid(7))
  firstName String
  lastName  String

  dateOfBirth DateTime? @db.Date
  phone       String?
  email       String?

  /// The Stripe Customer for this PERSON, created lazily on their first
  /// invoice and never at intake.
  ///
  /// Per resident rather than per stay, although money belongs to the stay
  /// everywhere else here: a Stripe Customer models a person, holds their
  /// saved payment method, and should survive a readmission. Per-stay would
  /// make a returning resident TWO named people in the Stripe dashboard —
  /// a second, redundant disclosure of the same protected fact. Episode
  /// separation is carried by `metadata.stayId`, an opaque id, instead.
  ///
  /// UNIQUE so a race between two managers pressing Send cannot quietly
  /// create two Customers and double the disclosure.
  stripeCustomerId String? @unique

  /// The LAST FOUR DIGITS ONLY. Never the full number — a facility has no use
  /// for one, and holding it turns a records breach into an identity-theft
  /// breach. Four digits is what a referral source or a lab asks for to confirm
  /// they have the right person.
  ///
  /// Read is restricted to admins and house managers in the API, not hidden in
  /// the client, and it never appears in an audit row or a log line. A CHECK in
  /// the migration refuses anything that is not exactly four digits, because
  /// the failure that matters is somebody pasting a whole SSN into this box.
  ssnLast4 String?

  /// Which housing/scheduling track this resident is on. Deliberately separate
  /// from gender identity: this drives bed eligibility and schedule scoping.
  /// If the facility ever needs to record gender identity or pronouns, that is
  /// a distinct field with distinct disclosure rules — do not overload this.
  cohort Cohort

  stays             Stay[]
  emergencyContacts EmergencyContact[]
  documents         Document[]
  insurance         InsurancePolicy?
  user              User?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([lastName, firstName])
  /// Referenced by Stay's composite foreign key — see Stay.
  @@unique([id, cohort])
  @@map("residents")
}

/// One episode of residency: intake → discharge. A resident who returns gets a
/// second Stay, so history stays clean and readmission is a first-class case.
model Stay {
  id String @id @default(uuid(7))

  /// `cohort` is carried here so the relation below can be a COMPOSITE foreign
  /// key, and so BedAssignment can join stay and bed on a matching cohort.
  ///
  /// Note there is deliberately NO apartmentId on Stay. The apartment a
  /// resident currently lives in is derived from their active bed assignment —
  /// storing it here too would create a second copy that a transfer could leave
  /// stale, and would contradict the bed they are actually in.
  residentId String
  cohort     Cohort
  resident   Resident @relation(fields: [residentId, cohort], references: [id, cohort])

  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  status              StayStatus @default(ACTIVE)
  intakeAt            DateTime
  expectedDischargeAt DateTime?

  dischargedAt  DateTime?
  dischargeType DischargeType?
  /// Required by policy whenever dischargeType is set. Enforced in the service
  /// layer — a discharge without a stated reason is not defensible later.
  dischargeReason String?

  /// Free text for now; likely becomes its own table once we know whether
  /// referral sources need contact details and reporting.
  referralSource String?

  /// The date the resident counts their sobriety from. On the Stay rather than
  /// the Resident because someone who relapses and returns starts a new count,
  /// and the previous episode's date is still the truth about that episode.
  sobrietyDate DateTime? @db.Date

  /// Overrides Program.serviceHoursRequired for THIS episode — a court or a
  /// case manager setting a figure that is not the phase default. Whole hours:
  /// an order says "80 hours", never 79.75.
  ///
  /// On the stay rather than the resident, so a readmission starts a fresh
  /// obligation. On the stay rather than the program, so an 80-hour order
  /// SURVIVES A PHASE CHANGE instead of dropping to 40 when somebody moves up.
  /// Null means use the program default; both null means no target, and
  /// therefore no bar and no dot.
  serviceHoursRequired Int?

  /// What the person doing the intake observed or was told at the door.
  /// Free text on purpose — it is a narrative note, not a field to report on.
  /// Whatever is written here is disclosable, so it belongs in the same
  /// conservative posture as everything else about the resident.
  intakeNotes String?

  bedAssignments BedAssignment[]
  ledgerEntries  LedgerEntry[]
  invoices       Invoice[]
  signOuts       SignOut[]

  scheduleAttendees   ScheduleAttendee[]
  scheduleAttendance  ScheduleAttendance[]
  serviceEntries      ServiceEntry[]
  checkLines          ApartmentCheckResident[]
  drugScreens         DrugScreen[]
  medications         Medication[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([residentId])
  /// Referenced by BedAssignment's and the schedule tables' composite foreign keys.
  @@unique([id, cohort])
  @@map("stays")
}

model EmergencyContact {
  id         String   @id @default(uuid(7))
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id])

  name         String
  relationship String?
  phone        String
  isPrimary    Boolean @default(false)

  /// 42 CFR Part 2: being listed as a contact does NOT authorize disclosure.
  /// Consent is tracked separately before anything is shared with this person.
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([residentId])
  @@map("emergency_contacts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Bed history — permanent, never deleted
// ─────────────────────────────────────────────────────────────────────────────

/// Answers "who was in bed 12B on March 12" for as long as the record is kept.
/// Rows are never updated except to set endedAt, and never soft-deleted: this
/// table has no deletedAt on purpose.
///
/// Note this records *assignment*, not physical presence — a resident out on a
/// travel pass still holds their bed. Presence is a separate question answered
/// by sign-outs and passes.
model BedAssignment {
  id String @id @default(uuid(7))

  /// Both relations are COMPOSITE and share `cohort`, which is what closes the
  /// loop: an assignment can only pair a bed and a stay whose cohorts match,
  /// and since the bed's cohort comes from its apartment, a resident can never
  /// be placed in a bed in the other cohort's apartment. Postgres enforces it —
  /// there is no route, script, or manual query that can produce a violation.
  cohort Cohort

  bedId  String
  bed    Bed    @relation(fields: [bedId, cohort], references: [id, cohort])
  stayId String
  stay   Stay   @relation(fields: [stayId, cohort], references: [id, cohort])

  startedAt DateTime
  /// Null means current. See the partial unique indexes noted below — they are
  /// what actually prevent double-booking.
  endedAt DateTime?

  /// Why the assignment ended: "transfer to 12A", "discharge", "unit repair".
  endedReason String?

  assignedById String
  assignedBy   User   @relation(fields: [assignedById], references: [id])

  createdAt DateTime @default(now())

  @@index([bedId, startedAt])
  @@index([stayId])
  @@map("bed_assignments")
}

/// One line on a resident's rent ledger.
///
/// The balance is SUM(charges) - SUM(payments + credits), derived on every read
/// and never stored. A stored balance is a second source of truth that drifts
/// from the entries meant to justify it, and the entries are the evidence — the
/// balance is only their sum.
///
/// Append-only, like BedAssignment and AuditLog: a mistake is corrected by a
/// new entry pointing at the old one, never by editing or deleting a row. This
/// is money in a regulated setting, and "what did this resident actually owe on
/// 30 June" has to stay answerable after someone fixes a typo in July.
///
/// Hangs off Stay rather than Resident: a resident who leaves and returns gets
/// a new stay, and the money from the previous episode belongs to that episode.
model LedgerEntry {
  id String @id @default(uuid(7))

  stayId String
  stay   Stay   @relation(fields: [stayId], references: [id])

  type LedgerEntryType

  /// Integer cents, and always POSITIVE — see LedgerEntryType. Floats are not
  /// an option for money. A CHECK constraint in the migration enforces the sign,
  /// because the one place this can go wrong is a caller passing a negative to
  /// "undo" something instead of writing the correcting entry.
  amountCents Int

  /// What the line is for: "Rent 1-15 July", "Damage to 12B door". Required —
  /// an unexplained charge is not defensible to a resident or an auditor.
  description String

  /// Set on a CHARGE, null on a payment or credit — enforced by a CHECK in the
  /// migration, since Prisma cannot make one column's nullability depend on
  /// another's value.
  category LedgerCategory?

  /// The payment processor's own id for this money — a Stripe PaymentIntent,
  /// say. Null for cash, a cheque, or anything recorded by hand.
  ///
  /// UNIQUE, and that is the whole point of having it: processor webhooks are
  /// delivered at-least-once, and this table cannot be corrected by deleting a
  /// row. Without this, one retried webhook is a permanent duplicate payment on
  /// a resident's balance. The insert fails instead, which is the right failure.
  externalRef String? @unique

  /// The date the line APPLIES to, which is not the date it was typed. July rent
  /// entered on 3 August is dated July, or every month-end total is wrong.
  occurredAt DateTime

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  /// Set when this entry corrects an earlier one, so a reader can follow a
  /// correction back to what it fixed instead of finding two contradictory
  /// lines and having to guess which is current.
  correctsId  String?
  corrects    LedgerEntry?  @relation("LedgerCorrection", fields: [correctsId], references: [id])
  correctedBy LedgerEntry[] @relation("LedgerCorrection")

  /// Set when this entry is the lab-confirmation fee for a screen (module 5).
  /// The screen owns the link; this is only its other end. A LIST rather than
  /// one, because an amended screen's versions all point at the one charge.
  screenCharges DrugScreen[] @relation("screenCharges")

  /// Whether this line has been billed — and note it is a RELATION, not a
  /// column. Marking a line billed would be an UPDATE, and this table refuses
  /// those by trigger AND by revoked privilege; "unbilled" is therefore the
  /// ABSENCE of a row here, which is a read. Module 11 chose this deliberately
  /// over relaxing the trigger for "just one column, only null → value".
  ///
  /// One-to-ONE only because invoice_lines is unique on ledgerEntryId — which
  /// is also what lets the ledger read project `billed` in one query instead
  /// of one per row.
  invoiceLine InvoiceLine?

  createdAt DateTime @default(now())
  // Deliberately no updatedAt and no deletedAt. Nothing here is ever updated or
  // deleted, so a column implying otherwise would be a lie in the schema.

  @@index([stayId, occurredAt])
  @@map("ledger_entries")
}

/// A same-day departure: destination, expected return, and the acknowledged
/// return that closes it. Hangs off Stay like the ledger — a returning
/// resident's sign-outs belong to the episode they happened in.
///
/// Presence (in house / out / overdue) is DERIVED from returnedAt and
/// expectedReturnAt against the clock, never stored — a stored flag would need
/// a job to flip it and would lie the minute the job lagged.
///
/// One OPEN sign-out per stay, enforced by a partial unique index in raw SQL
/// (Prisma cannot express it — see the sign_outs migration). Soft-deleted rows
/// are excluded, so removing a record made in error frees the slot.
model SignOut {
  id     String @id @default(uuid(7))
  stayId String
  stay   Stay   @relation(fields: [stayId], references: [id])

  destination String
  purpose     String?

  outAt            DateTime
  expectedReturnAt DateTime
  returnedAt       DateTime?

  recordedById String
  recordedBy   User   @relation("recordedSignOuts", fields: [recordedById], references: [id])

  /// Who saw them come back. Arrives together with returnedAt or not at all —
  /// a CHECK constraint holds the pair honest.
  returnAcknowledgedById String?
  returnAcknowledgedBy   User?   @relation("acknowledgedSignOuts", fields: [returnAcknowledgedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([stayId, outAt])
  @@map("sign_outs")
}

/// A resident's insurance, as captured at intake.
///
/// One per resident, replaced rather than versioned: unlike a screen result or
/// a med log, last year's policy number is not evidence of anything — it is
/// just stale. Soft-deleted like the rest of resident data, so nothing is
/// actually destroyed.
///
/// Its own table rather than four columns on Resident because these identifiers
/// are the most directly abusable data in the system, and keeping them in one
/// place means access to them can be narrowed later without touching the
/// resident record.
/// The event itself — identity only. No cohort, no time, no day.
///
/// "House Meeting" is one event both cohorts attend, at ONE time. Cohort lives
/// on the occurrence below and timing is copied identically across them, which
/// is what makes "everyone" expressible as two rows rather than as a nullable
/// column meaning everyone.
model ScheduleEvent {
  id          String  @id @default(uuid(7))
  title       String
  description String?
  /// Free text: "Common room", "St Mark's basement". An apartmentId with a
  /// composite (apartmentId, cohort) FK belongs on the OCCURRENCE rather than
  /// here — an apartment serves one cohort and an event spans both. Deferred.
  location    String?

  occurrences ScheduleOccurrence[]

  /// PROVENANCE FOR A MOVED SERIES. Set on the NEW event, pointing at the one it
  /// continues from.
  ///
  /// A recurrence rule cannot be edited once anything has been recorded against
  /// it: `expand()` gates on `occursOn` BEFORE it looks at materialized rows, so
  /// changing the weekdays of a group with a taken roll makes that session vanish
  /// from every read path while its attendance sits orphaned in the table. So
  /// "the Tuesday group moved to Thursdays" is not an UPDATE — it ends the old
  /// series the day before and starts a new one, which is what actually happened
  /// operationally, and leaves every past date still covered by its own rule.
  ///
  /// Borrowed from the amendment pattern in the footer of this file: one column,
  /// uniquely indexed, which makes a forked chain structurally impossible where a
  /// pair of columns would need a separate guard.
  ///
  /// NO `@unique` HERE, deliberately — events are soft-deletable, so the rule is a
  /// PARTIAL unique index in the migration (`one_live_successor_per_event`), the
  /// same reasoning and the same shape as `one_live_occurrence_per_event_cohort`
  /// below. A total index would let a successor created in error and then removed
  /// block the original from ever being moved again.
  ///
  /// Nothing renders this yet. It is here because provenance is impossible to
  /// reconstruct later — the same argument that put `LedgerEntry.externalRef` in
  /// before Stripe existed.
  /// Typed one-to-MANY here only because Prisma demands `@unique` on the defining
  /// side of a one-to-one, and `@unique` is the total index we must not have. The
  /// partial index is the real constraint; `supersededBy` is an array Postgres
  /// guarantees holds at most one live row. Same trade as the occurrence rule.
  supersedesId String?
  supersedes   ScheduleEvent?  @relation("scheduleEventSuccession", fields: [supersedesId], references: [id])
  supersededBy ScheduleEvent[] @relation("scheduleEventSuccession")

  /// Why the series moved. Optional — a court order or a room change is worth
  /// recording, "we swapped the days round" needs no ceremony.
  moveReason String?

  createdById String
  createdBy   User   @relation("createdScheduleEvents", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("schedule_events")
}

/// Cohort + when. ONE ROW PER ATTENDING COHORT — CLAUDE.md module 3.
///
/// The timing fields are IDENTICAL across every occurrence of an event: one
/// event has one time, entered once. `createEvent` is the only writer and
/// copies one set of fields, so the invariant holds by construction — nothing
/// in the database enforces it, which is why the read layer refuses to merge a
/// pair whose times disagree rather than draw a card that lies about when the
/// meeting starts. If a second writer or an importer ever exists, this wants a
/// trigger.
///
/// The split is a STORAGE detail and is invisible above the service: it exists
/// so the composite foreign keys can refuse a woman on a men's occurrence.
model ScheduleOccurrence {
  id      String        @id @default(uuid(7))
  eventId String
  event   ScheduleEvent @relation(fields: [eventId], references: [id])

  cohort Cohort

  /// WALL-CLOCK, stored as a string, and the one place in this app that
  /// deliberately does not store a UTC instant. A weekly 6pm is 6pm on both
  /// sides of a DST boundary; an instant would drift an hour in November.
  /// Converted per-date by facilityWallClockToUtc() at expansion.
  /// Precedent: Program.curfewLocalTime.
  startsAtLocal String
  /// Duration, not an end time. An end time that wraps midnight is a bug
  /// factory, and every consumer wants the length anyway.
  durationMinutes Int

  recurrence Recurrence
  /// 0=Sunday .. 6=Saturday on the facility calendar. Empty for ONCE.
  weekdays   Int[]
  startsOn   DateTime  @db.Date
  /// Null means open-ended, WEEKLY only. Ending a series sets this; past
  /// sessions and their attendance survive untouched.
  endsOn     DateTime? @db.Date

  attendees ScheduleAttendee[]
  sessions  ScheduleSession[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([cohort, startsOn])
  /// Referenced by the composite foreign keys on session and attendee.
  /// Consequence, same as Apartment: Postgres refuses to flip an occurrence's
  /// cohort while it holds either. Converting a men's group to a women's one is
  /// a deliberate operation, not an UPDATE.
  @@unique([id, cohort])
  // No @@unique([eventId, cohort]) here — occurrences are soft-deletable, so
  // that rule is a PARTIAL unique index in the migration. A plain one would
  // refuse to re-add a cohort that had been removed.
  @@map("schedule_occurrences")
}

/// A specific dated instance, MATERIALIZED LAZILY.
///
/// A row exists only because something date-specific was recorded against it:
/// attendance taken, this date cancelled, this date's time moved. Every other
/// date is computed from the occurrence's rule at read time. The alternative —
/// generating rows ahead of a horizon — needs a cron job this app deliberately
/// does not have, plus a backfill and a regeneration story when a rule changes.
///
/// Never soft-deleted: the row exists because it carries a record, so CANCEL is
/// the operation and delete is not one.
model ScheduleSession {
  id           String             @id @default(uuid(7))
  occurrenceId String
  cohort       Cohort
  occurrence   ScheduleOccurrence @relation(fields: [occurrenceId, cohort], references: [id, cohort])

  /// The facility CALENDAR date, not an instant. Compare these as 'YYYY-MM-DD'
  /// strings, never as Date objects — @db.Date round-trips as UTC midnight, and
  /// reading it as a local Date in America/New_York moves it a day.
  sessionDate DateTime @db.Date

  /// "Moved to 7 tonight". Same 'HH:MM' format as the occurrence.
  startsAtLocalOverride String?

  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("cancelledSessions", fields: [cancelledById], references: [id])
  cancelReason  String?

  /// What makes "the roll has been taken" a fact rather than a count. A session
  /// where everyone happened to be absent is otherwise indistinguishable from
  /// one nobody has marked, and those are very different records.
  attendanceTakenAt   DateTime?
  attendanceTakenById String?
  attendanceTakenBy   User?     @relation("tookAttendance", fields: [attendanceTakenById], references: [id])

  attendance ScheduleAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([occurrenceId, sessionDate])
  @@index([sessionDate])
  /// Referenced by ScheduleAttendance's composite foreign key.
  @@unique([id, cohort])
  @@map("schedule_sessions")
}

/// The ROSTER: who is on this occurrence. Hangs off Stay, not Resident — the
/// same reason as sign-outs and the ledger, and it is what makes a discharge
/// drop someone off every future session with no write at all.
///
/// THE RULE THIS TABLE AND ScheduleAttendance SHARE:
///   Before attendance is taken, a session's list is the live roster.
///   Once taken, it is the marks.
model ScheduleAttendee {
  id           String @id @default(uuid(7))
  occurrenceId String
  cohort       Cohort
  stayId       String

  /// Both composite, sharing `cohort` — mirrors BedAssignment. This is what
  /// makes a woman on a men's occurrence impossible at the database level, with
  /// no route, script or hand-written query able to produce one.
  occurrence ScheduleOccurrence @relation(fields: [occurrenceId, cohort], references: [id, cohort])
  stay       Stay               @relation(fields: [stayId, cohort], references: [id, cohort])

  addedById String
  addedBy   User   @relation("addedAttendees", fields: [addedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Taking someone off a group is soft: the record of having been on it
  /// survives, and the partial unique index lets them be added back.
  deletedAt DateTime?

  @@index([stayId])
  @@map("schedule_attendees")
}

/// The MARK: what happened for one person at one dated session.
///
/// Names the STAY, not the roster row. A mark is evidence in its own right and
/// must not dangle or vanish when somebody is later taken off the group.
///
/// No deletedAt, and no amendment chain: a mis-tap in a hallway is corrected by
/// changing the status. The audit extension already writes an UPDATE row with
/// the actor, the timestamp and the id, and that is the trail. Making a tech
/// file an amendment to fix a fat-fingered tap is exactly the friction that
/// puts attendance back on paper.
model ScheduleAttendance {
  id        String @id @default(uuid(7))
  sessionId String
  cohort    Cohort
  stayId    String

  session ScheduleSession @relation(fields: [sessionId, cohort], references: [id, cohort])
  stay    Stay            @relation(fields: [stayId, cohort], references: [id, cohort])

  status AttendanceStatus
  note   String?

  recordedById String
  recordedBy   User   @relation("recordedAttendance", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, stayId])
  @@index([stayId, createdAt])
  @@map("schedule_attendance")
}

/// One worked session of community service.
///
/// Hangs off Stay, like the ledger and sign-outs: a resident who leaves and
/// returns gets a new stay, and hours worked in the previous episode belong to
/// that episode.
///
/// EVERY COLUMN IS IMMUTABLE except the verification pair, which is WRITE-ONCE.
/// Enforced by trigger AND by a column-level UPDATE grant, so it holds against a
/// direct psql session and not only against our routes. A mistake is corrected
/// by an AMENDMENT — a new row with `supersedesId` and a reason — never an edit.
///
/// This is the first table in the repo to implement the amendment pattern at the
/// bottom of this file, and modules 4, 5 and 6 will copy it.
model ServiceEntry {
  id     String @id @default(uuid(7))
  stayId String
  stay   Stay   @relation(fields: [stayId], references: [id])

  /// Integer MINUTES. The ledger's integer-cents reasoning applies directly:
  /// hours are a DISPLAY unit, parsed once on the server, and 3.5h stored as
  /// 210 sums exactly where a float does not. The TARGET stays in whole hours
  /// and is converted in one place — services/communityService.js.
  ///
  /// Zero is legal only on an amendment: that is how an entry is VOIDED. You
  /// cannot originate nothing, and a CHECK says so.
  minutes Int

  /// The facility CALENDAR date the work was done — not the date it was typed.
  /// Same rule as LedgerEntry.occurredAt. Compare as 'YYYY-MM-DD' strings,
  /// never as Date objects; see services/schedule/expand.js for why.
  workedOn DateTime @db.Date

  /// Required. An hour with no place is not defensible to a court.
  location String

  /// The supervisor is someone OUTSIDE the facility — the food bank
  /// coordinator, the church custodian. Free text, the same call
  /// Stay.referralSource made: a relation would mean a directory of external
  /// people, consent questions, and a picker on a hallway form. The phone is
  /// here because verifying an hour means ringing them.
  supervisorName  String?
  supervisorPhone String?

  note String?

  /// Who authored THIS version. A resident submitting from the portal is still
  /// the author — their User row links to their Resident row.
  recordedById String
  recordedBy   User   @relation("recordedServiceEntries", fields: [recordedById], references: [id])

  /// ONLY VERIFIED HOURS COUNT toward a target. Null until a staff member
  /// confirms it. The pair arrives together (CHECK) and once (trigger); it is
  /// never cleared and never re-assigned — that would move somebody's name onto
  /// a claim they did not make. A verification made in error is corrected by
  /// amending the entry, which drops the original and its verifier out of the
  /// current view without erasing either.
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("verifiedServiceEntries", fields: [verifiedById], references: [id])

  /// AMENDMENT. One column, not two — the back-pointer is derivable, and storing
  /// it would be a second copy that can disagree AND an UPDATE on a table that
  /// otherwise has none. @unique is what stops a forked chain.
  supersedesId String?       @unique
  supersedes   ServiceEntry? @relation("ServiceAmendment", fields: [supersedesId], references: [id])
  supersededBy ServiceEntry? @relation("ServiceAmendment")
  /// Required whenever supersedesId is set, refused when it is not. The reason
  /// IS the record: without it the chain shows that a number changed and
  /// nothing about why.
  amendmentReason String?

  createdAt DateTime @default(now())
  // Deliberately no updatedAt and no deletedAt. The two lifecycle facts carry
  // their own clocks — verifiedAt, and an amendment's own createdAt — so an
  // updatedAt would be a third, redundant one. Keeping both off the table is
  // also what holds the UPDATE grant to exactly two columns.

  @@index([stayId, workedOn])
  @@map("service_entries")
}

/// One hourly round of one apartment: who was accounted for, and how.
///
/// Module 4, redefined by the facility (2026-08-06): staff walk EACH apartment
/// EVERY HOUR, 24/7, account for everyone who should be on site, and note what
/// each present resident is doing. Not an inspection checklist — a headcount.
///
/// APPEND-ONLY, stricter than service_entries: that table keeps one write-once
/// UPDATE (verification); this one has no transition at all, so UPDATE and
/// DELETE are refused by trigger AND revoked as privileges, on both tables.
/// A mistake is corrected by an AMENDMENT — a new row with `supersedesId` and
/// a reason — which carries the original's `checkedAt` VERBATIM: it corrects
/// what was observed, never when, so the amended check stays in its own hour.
///
/// `checkedAt` is always the SERVER clock at recording. A client-supplied time
/// is an invitation to back-fill the 2 PM round at 4; a round genuinely saved
/// late lands in the hour it was saved, which is the honest record. Hour
/// buckets, DUE/OVERDUE/MISSED — all of it is DERIVED from this instant on
/// read (services/checks.js), never stored. Same pattern as PRESENCE.
model ApartmentCheck {
  id          String    @id @default(uuid(7))
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id])

  /// The UTC instant the round was recorded — always the server clock.
  checkedAt DateTime

  /// Whole-apartment note, optional ("smoke smell in hallway").
  note String?

  recordedById String
  recordedBy   User   @relation("recordedApartmentChecks", fields: [recordedById], references: [id])

  /// Amendment pattern per the footer of this file. @unique is total, not
  /// partial — checks are never soft-deleted (unlike ScheduleEvent), so the
  /// one_live_successor trade does not apply. A trigger additionally pins an
  /// amendment to its original's apartment.
  supersedesId    String?         @unique
  supersedes      ApartmentCheck? @relation("CheckAmendment", fields: [supersedesId], references: [id])
  supersededBy    ApartmentCheck? @relation("CheckAmendment")
  /// Required whenever supersedesId is set, refused when it is not (CHECK).
  amendmentReason String?

  residents ApartmentCheckResident[]

  createdAt DateTime @default(now())
  // Deliberately no updatedAt and no deletedAt — append-only with no update
  // transition, and absent from SOFT_DELETE_MODELS like ServiceEntry.

  /// Serves "latest check per apartment" (the alarm) and the daily log.
  @@index([apartmentId, checkedAt(sort: Desc)])
  @@map("apartment_checks")
}

/// A demand for money: the unbilled lines of a stay, swept and sent.
///
/// Module 11's second half. A charge is UNBILLED until an invoice sweeps it,
/// and "unbilled" is the absence of an `invoice_lines` row — never a column on
/// the ledger, which refuses updates outright.
///
/// `totalCents` IS A SNAPSHOT, NOT A CACHED BALANCE, and the difference is the
/// whole reason this table may hold a total at all while CLAUDE.md forbids
/// storing a balance. A balance is recomputed; this one CANNOT be — the
/// migration's whitelist leaves `totalCents` outside the UPDATE grant, so
/// nothing, including a psql session, can move what was billed on the day it
/// was sent. A later correction lands on the LEDGER and flows onto the next
/// invoice; it never edits this one.
model Invoice {
  id     String @id @default(uuid(7))
  stayId String
  stay   Stay   @relation(fields: [stayId], references: [id])

  /// The sum of the lines beneath it, in integer cents, at the moment of
  /// sending. Charges add; credits subtract; the net must be positive, because
  /// an invoice for nothing is a document nobody meant to create.
  totalCents Int

  /// Due ON RECEIPT (facility policy, 2026-08-06) — so this is the issue date
  /// in practice. The record's red dot deliberately waits INVOICE_DOT_GRACE_DAYS
  /// past it: the invoice is past due immediately, the app shouts after a week.
  /// Grace delays the alarm, not the arithmetic — the OVERDUE_GRACE_MS idiom.
  dueAt DateTime

  status InvoiceStatus @default(DRAFT)

  /// Stripe's own ids and page. Null while DRAFT — an invoice Stripe has never
  /// seen. Unique so one local invoice can never bind to two Stripe invoices.
  stripeInvoiceId String? @unique
  number          String? @unique
  hostedUrl       String?

  issuedAt    DateTime?
  finalizedAt DateTime?
  paidAt      DateTime?
  voidedAt    DateTime?
  /// Required on a void. Voiding strands its lines permanently — they are
  /// never re-billable — so it says why.
  voidReason  String?

  sentById String
  sentBy   User   @relation("sentInvoices", fields: [sentById], references: [id])

  lines InvoiceLine[]

  createdAt DateTime @default(now())
  // No updatedAt and no deletedAt: an invoice is VOIDED, never deleted, and
  // every lifecycle fact already carries its own clock.

  @@index([stayId, createdAt(sort: Desc)])
  /// The overdue read's whole predicate.
  @@index([status, dueAt])
  @@map("invoices")
}

/// The link that makes a ledger line billed — its own append-only table
/// precisely so `ledger_entries` never takes an UPDATE.
///
/// Deliberately carries NO amount: the amount lives on the ledger entry, and a
/// copy here would be a second source of truth for the same cent. The invoice's
/// total is the one permitted copy, and only because the SUM must not move.
model InvoiceLine {
  id        String  @id @default(uuid(7))
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  /// UNIQUE, and it does three jobs: a charge cannot be billed twice; two
  /// managers pressing Send at the same instant produce one invoice and one
  /// 409 rather than a double bill; and it is what makes the back-relation
  /// 1:1 so the ledger read can project `billed` without an N+1.
  ledgerEntryId String      @unique
  ledgerEntry   LedgerEntry @relation(fields: [ledgerEntryId], references: [id])

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_lines")
}

/// Every Stripe event we have already handled.
///
/// Webhooks are delivered AT LEAST ONCE. `LedgerEntry.externalRef` already
/// makes a duplicated payment impossible, but that only protects the one
/// handler that writes a payment — a replayed `invoice.voided` would otherwise
/// be a second UPDATE. Four columns make every handler idempotent instead of
/// only the lucky one.
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())

  @@map("stripe_events")
}

/// One drug screen: the cup read on site, and the lab arc that may follow it.
///
/// Module 5. Two halves with different rules:
///
///   - THE COLLECTION IS IMMUTABLE. Who, when, why, who witnessed it, what the
///     cup said. None of it changes; a mistake is corrected by an AMENDMENT,
///     the pattern at the foot of this file.
///   - THE CONFIRMATION ARC TRANSITIONS, WRITE-ONCE. The resident's decision
///     arrives after collection; the lab's result after that. Same shape as
///     ServiceEntry's verification and for the reason module 7 gives: an
///     attestation about THIS row is intrinsic to it, and a join table would
///     be a second row saying "row 4 is true", which is worse.
///
/// A trigger enforces both — a whole-row comparison minus the confirmation
/// columns, so a column added in six months is immutable by default — and the
/// privilege grant agrees with it, so the rule holds against a psql session.
///
/// The lab's result never overwrites the cup's. Both stand: that a cup said
/// positive and a lab said negative is two facts, and the second does not
/// unmake the first.
model DrugScreen {
  id     String @id @default(uuid(7))
  stayId String
  stay   Stay   @relation(fields: [stayId], references: [id])

  reason ScreenReason
  method ScreenMethod

  /// When the specimen was given — CLIENT-SUPPLIED, deliberately unlike
  /// ApartmentCheck's server-clock `checkedAt`. A screen is recorded after the
  /// fact and this is chain-of-custody data, not a bucket label: nothing is
  /// derived from it. `createdAt` stays the honest record of when it was
  /// typed, so a late entry reads as a late entry, and a CHECK bounds this to
  /// a shift rather than a week.
  collectedAt DateTime

  /// The GLOSSARY's term is "collection witness" — the person who observed the
  /// sample being given. Module 5's prose said "observing staff"; the glossary
  /// wins, because it forbids synonyms.
  witnessedById String
  witnessedBy   User   @relation("witnessedScreens", fields: [witnessedById], references: [id])

  result ScreenResult
  /// What the cup detected. Required to be non-empty on a POSITIVE, and empty
  /// otherwise (CHECK) — "positive for something unspecified" is not a
  /// defensible record. DUPLICATES are refused in the service and in zod, NOT
  /// by the database: a CHECK cannot contain a subquery, so the DISTINCT
  /// comparison is not expressible. Written down rather than assumed.
  ///
  /// `@default([])` is declared so schema.prisma AGREES with the column the
  /// migration built. Prisma emits a scalar list as nullable with no default;
  /// the migration set NOT NULL DEFAULT '{}' because cardinality(NULL) is NULL
  /// and a CHECK passes on NULL. Without this line every future `migrate diff`
  /// proposes dropping that default — quietly reopening the hole.
  substances Substance[] @default([])

  /// The seal or label number — what ties this row to a lab report, and the
  /// thing CLAUDE.md means by "chain of custody matters". Required whenever a
  /// specimen exists, which is every result except NEGATIVE and REFUSAL.
  specimenId String?

  /// ONE free-text column, deliberately. The structured columns around it ARE
  /// the chain of custody; a second "custodyNotes" would only be somewhere for
  /// the same sentence to be written twice.
  note String?

  recordedById String
  recordedBy   User   @relation("recordedScreens", fields: [recordedById], references: [id])

  // ── The confirmation arc: the only columns that may ever transition ───────
  confirmation ConfirmationStatus @default(NOT_OFFERED)

  residentDecisionAt   DateTime?
  decisionRecordedById String?
  decisionRecordedBy   User?     @relation("screenDecisions", fields: [decisionRecordedById], references: [id])

  /// The $50 charge this election produced, linked rather than recomputed.
  ///
  /// DELIBERATELY NOT @unique, unlike LedgerEntry.externalRef — and this is
  /// the subtle one. An amendment carries the arc forward verbatim, so every
  /// version of one screen legitimately points at the SAME charge, and a
  /// unique index would refuse to let a charged screen be amended at all:
  /// exactly the screen you would most want to correct.
  ///
  /// Exactly-once is held instead by the arc trigger — a row leaves
  /// PENDING_DECISION once, and an amendment arrives already past it so it can
  /// never transition — plus the service guard, plus an assertion that an
  /// amended charged screen still has exactly one charge on the stay. That is
  /// weaker than a unique index and this comment says so rather than implying
  /// otherwise.
  feeLedgerEntryId String?
  feeLedgerEntry   LedgerEntry? @relation("screenCharges", fields: [feeLedgerEntryId], references: [id])

  /// Free text, the ServiceEntry.supervisorName precedent: an outside lab is
  /// not worth a directory, a picker and a consent question.
  labName      String?
  labReference String?
  labSentAt    DateTime?

  labResult       ScreenResult?
  /// `@default([])` for the same reason as `substances` above.
  labSubstances   Substance[]   @default([])
  labReturnedAt   DateTime?
  labRecordedById String?
  labRecordedBy   User?         @relation("screenLabResults", fields: [labRecordedById], references: [id])

  /// Amendment, per the footer of this file.
  supersedesId    String?     @unique
  supersedes      DrugScreen? @relation("ScreenAmendment", fields: [supersedesId], references: [id])
  supersededBy    DrugScreen? @relation("ScreenAmendment")
  amendmentReason String?

  createdAt DateTime @default(now())
  // No updatedAt, no deletedAt — absent from SOFT_DELETE_MODELS with
  // ServiceEntry and the apartment-check tables.

  @@index([stayId, collectedAt(sort: Desc)])
  /// Serves the work queue, which reads by arc state.
  @@index([confirmation])
  @@map("drug_screens")
}

/// One resident's line on one check — the roster as found, snapshotted.
///
/// References the STAY, like sign-outs and the schedule roster: on discharge
/// the person drops out of future rosters with no write, and a returning
/// resident's old checks stay with the old episode.
///
/// Deliberately NO signOutId on a SIGNED_OUT line: which sign-out accounted
/// for them is derivable (stayId + checkedAt interval containment), and a
/// stored pointer would couple an append-only table to a soft-deletable one.
model ApartmentCheckResident {
  id      String         @id @default(uuid(7))
  checkId String
  check   ApartmentCheck @relation(fields: [checkId], references: [id])

  stayId String
  stay   Stay   @relation(fields: [stayId], references: [id])

  status CheckResidentStatus
  /// REQUIRED when PRESENT (CHECK in the migration): "what were they doing"
  /// is the record the facility asked for. Optional otherwise.
  note   String?

  @@unique([checkId, stayId])
  /// Serves the RLS own-stay policy and the resident record's future section.
  @@index([stayId])
  @@map("apartment_check_residents")
}

/// One medication a resident is on — the standing instruction, not evidence.
///
/// The facility's model (confirmed 2026-08-07, closing open question 3) is
/// STAFF-STORED, RESIDENT SELF-ADMINISTERED: the house holds the meds, staff
/// hand over the dose and observe it being taken. Staff never administer, so
/// this is not a clinical MAR — there is no route, no site, no PRN protocol.
/// The house stores NO controlled substances, so there is deliberately no
/// count, no on-hand figure and no reconciliation anywhere in this module.
///
/// Freely UPDATABLE and soft-deletable, the maintenance_requests posture: a
/// dose that changes is current state, not a new fact about the past. Two rules
/// keep that safe, and both are enforced in services/meds.js:
///
///   1. A medication with any log CANNOT BE DELETED, only ended (`endsOn`).
///      Soft-deleting it would make the soft-delete extension filter it out of
///      every read and silently erase the dose history hanging off it — the
///      identical failure the ScheduleEvent rule warns about.
///   2. MedLog SNAPSHOTS `name` and `dosage`, so raising a dose next month
///      cannot rewrite what was handed over last week. Deliberately a second
///      copy that MAY disagree, exactly like Invoice.totalCents.
///
/// Hangs off Stay, like the ledger, sign-outs, service hours and check lines: a
/// readmission starts a fresh list, and a discharge drops the resident off every
/// future pass WITH NO WRITE AT ALL.
model Medication {
  id     String @id @default(uuid(7))
  stayId String
  stay   Stay   @relation(fields: [stayId], references: [id])

  /// As written on the label.
  name String
  /// "500 mg, 1 tablet" — label text, deliberately not a structured dose. A
  /// quantity/unit/route triple is MAR territory and this facility does not
  /// administer.
  dosage String
  /// "with food", "do not crush".
  instructions String?
  /// Text references, the ServiceEntry.supervisorName precedent: neither is an
  /// entity in this app and neither needs to be.
  prescriber String?
  pharmacy   String?

  /// The dose times, as facility WALL-CLOCK 'HH:MM' strings — never instants.
  /// ScheduleOccurrence.startsAtLocal's rule verbatim and for its reason: an
  /// 8pm dose is 8pm on both sides of a DST boundary, where a stored instant
  /// drifts an hour in November. Converted per date by facilityWallClockToUtc().
  ///
  /// A Prisma scalar list emits a NULLABLE column with no default, so the
  /// migration adds SET NOT NULL + SET DEFAULT — otherwise cardinality(NULL) is
  /// NULL and the CHECK below passes on NULL.
  times String[] @default([])

  /// As-needed. A PRN medication carries NO times and never reads DUE — it is
  /// logged when it is actually taken. Paired with `times` by CHECK.
  isPrn Boolean @default(false)

  startsOn DateTime @db.Date
  /// Discontinuation. This is how a medication ends — never a delete once
  /// anything has been logged against it, and never earlier than the last
  /// logged dose. Paired with `endReason` by CHECK: an unexplained
  /// discontinuation is exactly what an auditor asks about.
  endsOn    DateTime? @db.Date
  endReason String?

  addedById String
  addedBy   User   @relation("addedMedications", fields: [addedById], references: [id])

  logs MedLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// The composite-FK target for MedLog, so a log can never claim a medication
  /// belonging to a different stay. Same idiom as Stay's @@unique([id, cohort]).
  @@unique([id, stayId])
  @@index([stayId])
  @@map("medications")
}

/// One dose, as observed. Append-only evidence, amendment pattern.
///
/// Stricter than service_entries, which keeps one write-once UPDATE for
/// verification: a dose has no transition at all, so every UPDATE and DELETE is
/// refused by trigger AND by revoked privilege.
///
/// `observedById` is the OBSERVING STAFF MEMBER — the glossary's term, and
/// deliberately NOT module 5's `witnessedById`. Watching somebody swallow their
/// own medication and taking custody of a specimen are different acts and keep
/// different words. `recordedById` is whoever typed it, usually the same person;
/// both are kept because a second staff member entering it later is a real case,
/// and only one of them attests to having watched.
model MedLog {
  id           String @id @default(uuid(7))
  medicationId String
  /// Carried directly for the RLS own-stay policy and the resident record's
  /// keyset read — the apartment_check_residents precedent. The COMPOSITE
  /// foreign key below is what makes a mismatched pair impossible: Postgres
  /// itself refuses a log claiming stay B against stay A's medication.
  stayId String

  medication Medication @relation(fields: [medicationId, stayId], references: [id, stayId])

  /// The scheduled instant this log answers, from facilityWallClockToUtc(date,
  /// time). NULL for a PRN dose — nothing was scheduled, so there is no slot to
  /// answer. One live log per (medicationId, scheduledFor), by trigger.
  scheduledFor DateTime?

  status MedLogStatus

  observedById String
  observedBy   User   @relation("observedMedLogs", fields: [observedById], references: [id])
  recordedById String
  recordedBy   User   @relation("recordedMedLogs", fields: [recordedById], references: [id])

  /// Snapshots, taken at the dose. See Medication's note: these exist precisely
  /// so a later edit to the med list cannot rewrite the record of what was
  /// actually handed over.
  medicationName String
  dosage         String

  /// REQUIRED for REFUSED and HELD (CHECK in the migration), optional for GIVEN.
  note String?

  supersedesId    String? @unique
  supersedes      MedLog? @relation("MedAmendment", fields: [supersedesId], references: [id])
  supersededBy    MedLog? @relation("MedAmendment")
  amendmentReason String?

  createdAt DateTime @default(now())

  @@index([stayId, scheduledFor(sort: Desc)])
  @@index([medicationId])
  @@map("med_logs")
}

model InsurancePolicy {
  id String @id @default(uuid(7))

  residentId String   @unique
  resident   Resident @relation(fields: [residentId], references: [id])

  provider     String
  policyNumber String
  groupNumber  String?

  /// Null means the resident is the policy holder, which is the common case.
  /// Storing "Same as client" as text would make that fact unqueryable.
  policyHolder String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("insurance_policies")
}

// ─────────────────────────────────────────────────────────────────────────────
// Program / phase
// ─────────────────────────────────────────────────────────────────────────────

/// Phase privileges are FACILITY POLICY, not defaults to invent. Every
/// privilege field below is nullable and ships empty — they get filled in from
/// the facility's actual rules before this is used to gate anything.
model Program {
  id   String @id @default(uuid(7))
  name String @unique
  /// Ordering only — 1, 2, 3. Not a privilege level by itself.
  level Int

  curfewLocalTime      String? // "22:00", interpreted in the Apartment timezone
  serviceHoursRequired Int?
  passEligible         Boolean?
  minDaysBeforePass    Int?

  stays Stay[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("programs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Documents
// ─────────────────────────────────────────────────────────────────────────────

model Document {
  id         String   @id @default(uuid(7))
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id])

  type     DocumentType
  fileName String

  /// Object-storage key, never a public URL. Access is brokered by the API so
  /// every read is authorized and audited — files must not be publicly
  /// reachable by guessing a link.
  storageKey String
  mimeType   String
  sizeBytes  Int

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([residentId])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// Staff & access
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid(7))
  email        String    @unique
  passwordHash String
  fullName     String
  role         StaffRole

  /// Set only for RESIDENT accounts. Whether residents get accounts at intake
  /// is still open — see CLAUDE.md open questions.
  residentId String?   @unique
  resident   Resident? @relation(fields: [residentId], references: [id])

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  /// Lockout after repeated failures. Counted per account, reset on success.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  bedAssignments   BedAssignment[]
  ledgerEntries    LedgerEntry[]
  documents        Document[]
  auditEntries     AuditLog[]
  sessions         Session[]
  reportedRequests MaintenanceRequest[] @relation("reportedRequests")
  assignedRequests MaintenanceRequest[] @relation("assignedRequests")
  maintenanceEvents MaintenanceEvent[]  @relation("maintenanceEvents")
  recordedSignOuts     SignOut[] @relation("recordedSignOuts")
  acknowledgedSignOuts SignOut[] @relation("acknowledgedSignOuts")

  createdScheduleEvents ScheduleEvent[]      @relation("createdScheduleEvents")
  cancelledSessions     ScheduleSession[]    @relation("cancelledSessions")
  tookAttendance        ScheduleSession[]    @relation("tookAttendance")
  addedAttendees        ScheduleAttendee[]   @relation("addedAttendees")
  recordedAttendance    ScheduleAttendance[] @relation("recordedAttendance")

  recordedServiceEntries ServiceEntry[] @relation("recordedServiceEntries")
  verifiedServiceEntries ServiceEntry[] @relation("verifiedServiceEntries")

  recordedApartmentChecks ApartmentCheck[] @relation("recordedApartmentChecks")

  sentInvoices Invoice[] @relation("sentInvoices")

  witnessedScreens  DrugScreen[] @relation("witnessedScreens")
  recordedScreens   DrugScreen[] @relation("recordedScreens")
  screenDecisions   DrugScreen[] @relation("screenDecisions")
  screenLabResults  DrugScreen[] @relation("screenLabResults")

  addedMedications Medication[] @relation("addedMedications")
  /// Two relations, one act each: who watched the dose, and who typed it.
  observedMedLogs  MedLog[]     @relation("observedMedLogs")
  recordedMedLogs  MedLog[]     @relation("recordedMedLogs")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

/// Server-side sessions, deliberately NOT stateless JWTs.
///
/// CLAUDE.md requires server-enforced idle timeout and the ability to end a
/// session immediately — when a staff member is terminated, or a shared house
/// phone goes missing. A JWT cannot be revoked without a blocklist, and a
/// blocklist is this table with extra steps.
///
/// The cookie carries only a random opaque id. `tokenHash` means a database
/// leak does not hand over live sessions.
model Session {
  id        String @id @default(uuid(7))
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Sliding: bumped on each authenticated request. Idle past this and the
  /// session is dead regardless of absoluteExpiresAt.
  idleExpiresAt DateTime
  /// Hard ceiling. A session cannot be kept alive forever by staying active.
  absoluteExpiresAt DateTime

  revokedAt     DateTime?
  revokedReason String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
  @@map("sessions")
}

/// Append-only. Never updated, never deleted, no deletedAt. Written by the
/// Prisma client extension so it cannot be forgotten at a call site.
///
/// IDs ONLY — no names, no screen results, no med details. This table will be
/// read by people who are not authorized to see the underlying records.
model AuditLog {
  id String   @id @default(uuid(7))
  at DateTime @default(now())

  actorId   String?
  actor     User?      @relation(fields: [actorId], references: [id])
  actorRole StaffRole?

  action AuditAction
  /// Model name, e.g. "Resident".
  entity   String
  entityId String?

  /// Which resident's data this touched, when applicable — lets us answer
  /// "show every access to this resident's record" without scanning payloads.
  subjectResidentId String?

  ipAddress String?
  userAgent String?
  requestId String?

  @@index([subjectResidentId, at])
  @@index([actorId, at])
  @@index([entity, entityId])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOT EXPRESSIBLE IN PRISMA — add as raw SQL to the first migration
// ─────────────────────────────────────────────────────────────────────────────
//
// 1. One live occupant per bed:
//      CREATE UNIQUE INDEX one_active_assignment_per_bed
//        ON bed_assignments (bed_id) WHERE ended_at IS NULL;
//
// 2. One live bed per stay:
//      CREATE UNIQUE INDEX one_active_bed_per_stay
//        ON bed_assignments (stay_id) WHERE ended_at IS NULL;
//
// 3. Row-level security policies (see CLAUDE.md) — resident accounts must not
//    be able to read rows belonging to other residents.
//
// (Bed-to-apartment consistency needs nothing here: with Stay.apartmentId gone,
// the active bed assignment IS the apartment, so the two cannot disagree.)
//
// Prisma cannot express partial unique indexes, so these go into the generated
// migration before it is applied.
//
// ─────────────────────────────────────────────────────────────────────────────
// SCHEDULE DESIGN — decided, not yet built
// ─────────────────────────────────────────────────────────────────────────────
//
// Some events are men-only, some women-only, and some are attended by both —
// often at DIFFERENT times, which is the whole point of gendered scheduling.
// So the cohort does not live on the event; it lives on the occurrence:
//
//   ScheduleEvent  { id, title, description, location, apartmentId?, recurrence }
//   ScheduleEventCohort { eventId, cohort, startsAtLocal, endsAtLocal }
//         @@unique([eventId, cohort])
//
//   men-only        → one row  (MEN)
//   women-only      → one row  (WOMEN)
//   both, same time → two rows, same time
//   both, staggered → two rows, different times   ← the realistic case
//
// A resident's schedule is always a join through their cohort. There is no
// nullable `cohort` column that silently means "everyone", which is the failure
// mode CLAUDE.md warns about — a forgotten filter would otherwise show a
// resident the other cohort's meeting times.
//
// ─────────────────────────────────────────────────────────────────────────────
// AMENDMENT PATTERN — for the event tables in later slices
// ─────────────────────────────────────────────────────────────────────────────
//
// Apartment checks, drug screens, med logs and service hours are evidence. They
// are never updated in place. Each of those tables carries:
//
//   supersedesId    String?  @unique   // the entry this one corrects
//   amendmentReason String?            // required when supersedesId is set
//   recordedById    String             // who authored this version
//
// A correction is a PURE INSERT: a new row pointing at the original. Nothing on
// the original changes. Reads filter to `supersededBy: { is: null }` for the
// current view; the full chain stays available for audit.
//
// REVISED 2026-08-05, when service_entries became the first implementor. This
// block used to prescribe a `supersededById` back-pointer on the original as
// well. It was dropped, and the reason generalises to every table that copies
// this:
//
//   - `A.supersededById = B.id` holds IFF `B.supersedesId = A.id`. Two columns
//     that must agree is a class of bug, and nothing needs the second one.
//   - Setting it is an UPDATE, on a table whose whole point is that it has
//     none. Dropping it means these tables can hold an UPDATE grant scoped to
//     the one transition they genuinely need — for service_entries, verification.
//   - `@unique` on `supersedesId` makes a FORKED chain structurally impossible:
//     two rows cannot both claim to correct the same entry. The two-column
//     version needs a separate guard for that.
//
// See `ServiceEntry` above for the implementation, and its migration for the
// trigger that keeps everything except the sanctioned transition immutable.
