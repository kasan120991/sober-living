# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL="postgresql://soberlife:soberlife@localhost:5432/soberlife?schema=public"

# RUNTIME connection. Must NOT be the owner or a superuser — both bypass
# row-level security, which would make the policies decorative.
#
# Setup:  npx prisma migrate deploy        (creates the role, no password)
#         APP_DB_PASSWORD=... npm run db:app-role   (grants LOGIN, sets password)
#
# The credentials below are local-development throwaways, exactly like
# DATABASE_URL above. Production uses different ones and they never live here.
APP_DATABASE_URL="postgresql://soberlife_app:soberlife-app-dev@localhost:5432/soberlife?schema=public"

# Read only by scripts/db-app-role.js when setting the role's password.
# Leave empty here and pass it in the environment — do not commit a real one.
APP_DB_PASSWORD=""

# The facility is a single site, so its timezone is one value for the whole
# app rather than a column on each apartment. Curfews, med windows and pass
# returns are local times that cross midnight, and they are read against this.
FACILITY_TIMEZONE="America/New_York"

PORT=3001
NODE_ENV=development

# Comma-separated origins allowed to call this API. No wildcards — the admin and
# resident apps are the only two clients, and credentials ride on cookies.
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# Minutes of inactivity before a session is dead. Shared staff devices are the
# norm in a house, so this stays short.
SESSION_IDLE_MINUTES=20

# Hard ceiling on a session regardless of activity.
SESSION_ABSOLUTE_HOURS=12
